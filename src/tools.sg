// =============================================================================
// tools.sg — pure helpers for tool execution & observation formatting
// =============================================================================
//
// These shape what the tools return and what the model sees: line-numbered
// reads, truncated observations, occurrence counting for the unique-match edit
// contract, and shell-safe quoting. All pure — no Fs/Shell — so the agent body
// stays thin and these stay unit-testable.

use ui::sage_dark;
use ui::reset;
use proto::parse_digits;

// Prefix each line with its number, dim, starting from `start`. A windowed read
// still reports the line numbers the file actually has: getting this wrong would
// be quietly destructive, since the model copies these numbers into its next
// `edit`.
//
// Note the ordering: Sage resolves functions in declaration order, so a helper
// has to appear above its callers.
pub fn number_lines_from(s: String, first: Int) -> String {
    let ls = lines(s);
    let out: List<String> = [];
    let n = first;
    for line in ls {
        out = push(out, sage_dark() ++ str(n) ++ reset() ++ " " ++ line);
        n = n + 1;
    }
    return join(out, "\n");
}

// The whole file, numbered from 1, for `read` without a window.
pub fn number_lines(s: String) -> String {
    let ls = lines(s);
    let out: List<String> = [];
    let n = 1;
    for line in ls {
        out = push(out, sage_dark() ++ str(n) ++ reset() ++ " " ++ line);
        n = n + 1;
    }
    return join(out, "\n");
}

pub fn line_count(s: String) -> Int {
    let ls = lines(s);
    return len(ls);
}

// Lines [from, from+count), 1-based. A count of 0 or less means "to the end".
pub fn slice_lines(s: String, from: Int, count: Int) -> String {
    let ls = lines(s);
    let out: List<String> = [];
    let i = 1;
    let taken = 0;
    for line in ls {
        if i >= from {
            if count <= 0 || taken < count {
                out = push(out, line);
                taken = taken + 1;
            }
        }
        i = i + 1;
    }
    return join(out, "\n");
}

// What to say after a windowed or clipped read, so the model knows there is
// more and how to ask for it rather than assuming it has seen the file.
pub fn read_footer(path: String, shown_from: Int, shown_to: Int, total: Int) -> String {
    if shown_from <= 1 && shown_to >= total {
        return "";
    }
    return "\n... showing lines " ++ str(shown_from) ++ "-" ++ str(shown_to) ++ " of " ++ str(total) ++ " in " ++ path ++ ". Ask for more with <read>" ++ path ++ "<from>N</from></read>.";
}

// Clip an observation to `max` chars, with a visible marker.
pub fn truncate(s: String, max: Int) -> String {
    if str_len(s) <= max {
        return s;
    }
    return str_slice(s, 0, max) ++ "\n... (truncated)";
}

// Count non-overlapping occurrences of needle in hay. Drives the edit
// unique-match contract (0 -> not found, >1 -> ambiguous).
pub fn count_occurrences(hay: String, needle: String) -> Int {
    if needle == "" {
        return 0;
    }
    let count = 0;
    let rest = hay;
    loop {
        let i = str_index_of(rest, needle);
        if is_none(i) {
            break;
        }
        count = count + 1;
        rest = str_slice(rest, unwrap(i) + str_len(needle), str_len(rest));
    }
    return count;
}

// Characters the transcript will occupy in the prompt, separators included.
pub fn transcript_size(entries: List<String>) -> Int {
    let total = 0;
    for e in entries {
        total = total + str_len(e) + 2;
    }
    return total;
}

// The elision marker is itself a transcript entry, so compaction has to
// recognise its own leavings. Without this, every step prepends a fresh marker
// and the transcript creeps upward by one marker per step: a slow leak that
// looks exactly like the bound working.
pub const ELIDED_MARK: String = " earlier observations elided";

pub fn is_elision_marker(e: String) -> Bool {
    return starts_with(e, "[") && str_contains(e, ELIDED_MARK);
}

// The running total carried by an existing marker, so the count survives being
// compacted again.
pub fn marker_count(e: String) -> Int {
    let sp = str_index_of(e, " ");
    if is_none(sp) {
        return 0;
    }
    return parse_digits(str_slice(e, 1, unwrap(sp)), 0);
}

// Keep the transcript inside `budget`, newest first.
//
// Walking backwards means the model keeps the steps it just took, which are the
// ones it needs, and loses the oldest observations, which are usually a file it
// has already acted on. Two things are never dropped: the most recent entries
// (`keep_recent`, whatever their size, so a large observation cannot evict
// itself) and every `USER:` line, because those are the task statements and
// forgetting what was asked is the one failure that makes the rest pointless.
//
// What goes is replaced by a single marker, so the model can tell the
// difference between "this never happened" and "you are no longer being shown
// it", and can read the file again if it needs to.
pub fn compact_history(entries: List<String>, budget: Int, keep_recent: Int) -> List<String> {
    if transcript_size(entries) <= budget {
        return entries;
    }

    // Lift out any previous marker and carry its count forward, so there is only
    // ever one and it reports the true running total.
    let carried = 0;
    let real: List<String> = [];
    for e in entries {
        if is_elision_marker(e) {
            carried = carried + marker_count(e);
        } else {
            real = push(real, e);
        }
    }

    let newest_first = reverse(real);
    let kept_reversed: List<String> = [];
    let used = 0;
    let dropped = 0;
    let i = 0;

    for e in newest_first {
        let size = str_len(e) + 2;
        let protected = i < keep_recent || starts_with(e, "USER: ");
        if protected || used + size <= budget {
            kept_reversed = push(kept_reversed, e);
            used = used + size;
        } else {
            dropped = dropped + 1;
        }
        i = i + 1;
    }

    let kept = reverse(kept_reversed);
    let total_dropped = carried + dropped;
    if total_dropped == 0 {
        return kept;
    }

    let marked: List<String> = [];
    marked = push(marked, "[" ++ str(total_dropped) ++ ELIDED_MARK ++ " to stay within the context budget. Read a file again if you need it.]");
    for e in kept {
        marked = push(marked, e);
    }
    return marked;
}

pub fn list_contains(items: List<String>, needle: String) -> Bool {
    let found = false;
    for item in items {
        if item == needle {
            found = true;
        }
    }
    return found;
}

// Single-quote a string for safe use inside a shell command.
pub fn shell_quote(s: String) -> String {
    return "'" ++ replace(s, "'", "'\\''") ++ "'";
}
