// =============================================================================
// ui.sg — Ward's visual language
// =============================================================================
//
// Pure terminal chrome: the 24-bit ANSI palette, box-drawing glyphs, status
// lines, the banner, the red/green diff, and the interactive `confirm` prompt.
//
// Visual identity uses the official Sage mascot palette:
//   Feather Base Dark  #3D4F44   Feather Mid Sage  #5A7A62
//   Feather Light      #8FA88F   Brow/Accent Gold  #D4A017
//   Gold Highlights    #F0C040   Background Dark   #1A1F1E

// =============================================================================
// ANSI control + box-drawing glyphs
// =============================================================================

pub const ESC: String = "\x1b";

pub const BOX_H: String = "─";
pub const BOX_V: String = "│";
pub const BOX_TL: String = "┌";
pub const BOX_TR: String = "┐";
pub const BOX_BL: String = "└";
pub const BOX_BR: String = "┘";
pub const BOX_RTL: String = "╭";
pub const BOX_RTR: String = "╮";
pub const BOX_RBL: String = "╰";
pub const BOX_RBR: String = "╯";
pub const CHECK: String = "✓";
pub const CROSS: String = "✗";
pub const TRIANGLE: String = "▲";
pub const ARROW: String = "▸";
pub const DIAMOND: String = "◆";

// =============================================================================
// Colour primitives — 24-bit escape codes
// =============================================================================

pub fn sage_dark() -> String {
    return ESC ++ "[38;2;61;79;68m";
}

pub fn sage_mid() -> String {
    return ESC ++ "[38;2;90;122;98m";
}

pub fn sage_light() -> String {
    return ESC ++ "[38;2;143;168;143m";
}

pub fn gold() -> String {
    return ESC ++ "[38;2;212;160;23m";
}

pub fn gold_bright() -> String {
    return ESC ++ "[38;2;240;192;64m";
}

pub fn green() -> String {
    return ESC ++ "[38;2;120;180;110m";
}

pub fn reset() -> String {
    return ESC ++ "[0m";
}

pub fn bold() -> String {
    return ESC ++ "[1m";
}

pub fn dim() -> String {
    return ESC ++ "[2m";
}

pub fn red() -> String {
    return ESC ++ "[38;2;180;60;50m";
}

pub fn warm_white() -> String {
    return ESC ++ "[38;2;220;215;200m";
}

pub fn styled(text: String, style: String) -> String {
    if style == "gold" {
        return gold() ++ text ++ reset();
    } else if style == "bright" {
        return gold_bright() ++ text ++ reset();
    } else if style == "sage" {
        return sage_mid() ++ text ++ reset();
    } else if style == "sage_light" {
        return sage_light() ++ text ++ reset();
    } else if style == "sage_dark" {
        return sage_dark() ++ text ++ reset();
    } else if style == "warm" {
        return warm_white() ++ text ++ reset();
    } else if style == "dim" {
        return dim() ++ sage_light() ++ text ++ reset();
    } else if style == "bold" {
        return bold() ++ warm_white() ++ text ++ reset();
    } else if style == "bold_gold" {
        return bold() ++ gold() ++ text ++ reset();
    } else if style == "bold_bright" {
        return bold() ++ gold_bright() ++ text ++ reset();
    } else if style == "error" {
        return bold() ++ red() ++ text ++ reset();
    }
    return text;
}

// =============================================================================
// Structural chrome — rules, headers, status lines
// =============================================================================

pub fn hr(width: Int) -> String {
    let line = str_repeat(BOX_H, width);
    return sage_dark() ++ line ++ reset();
}

pub fn header(title: String) -> String {
    let bar = str_repeat(BOX_H, 3);
    return "\n" ++ sage_mid() ++ BOX_RTL ++ bar ++ BOX_H ++ reset() ++ " " ++ bold() ++ gold() ++ title ++ reset() ++ " " ++ sage_mid() ++ BOX_H ++ bar ++ BOX_RTR ++ reset() ++ "\n";
}

pub fn footer() -> String {
    let bar = str_repeat(BOX_H, 3);
    return sage_mid() ++ BOX_RBL ++ bar ++ BOX_H ++ BOX_H ++ BOX_H ++ BOX_H ++ BOX_H ++ reset() ++ "\n";
}

pub fn status(label: String, msg: String) -> String {
    return "  " ++ sage_dark() ++ BOX_V ++ reset() ++ " " ++ gold() ++ label ++ reset() ++ " " ++ sage_light() ++ msg ++ reset();
}

pub fn success(msg: String) -> String {
    return "  " ++ sage_dark() ++ BOX_V ++ reset() ++ " " ++ gold_bright() ++ CHECK ++ reset() ++ " " ++ warm_white() ++ msg ++ reset();
}

pub fn failure(msg: String) -> String {
    return "  " ++ sage_dark() ++ BOX_V ++ reset() ++ " " ++ red() ++ CROSS ++ reset() ++ " " ++ warm_white() ++ msg ++ reset();
}

pub fn warning(msg: String) -> String {
    return "  " ++ sage_dark() ++ BOX_V ++ reset() ++ " " ++ gold() ++ TRIANGLE ++ reset() ++ " " ++ warm_white() ++ msg ++ reset();
}

pub fn ward_says(msg: String) -> String {
    return "  " ++ sage_dark() ++ BOX_V ++ reset() ++ " " ++ gold() ++ ARROW ++ reset() ++ " " ++ bold() ++ warm_white() ++ "Ward" ++ reset() ++ sage_light() ++ ": " ++ msg ++ reset();
}

pub fn indent_text(text: String, prefix: String) -> String {
    let parts = lines(text);
    let indented = map(parts, |line: String| "  " ++ sage_dark() ++ BOX_V ++ reset() ++ " " ++ prefix ++ line);
    return join(indented, "\n");
}

// =============================================================================
// The banner
// =============================================================================

pub const BANNER_WIDTH: Int = 42;

// One row of the box. `text` is the plain, uncoloured content: padding is
// measured against it and the colour applied afterwards, because escape codes
// are invisible on screen but not to `str_len`. Hand-counted spaces are what
// left the box ragged for the whole of v0.3.0.
pub fn box_row(text: String, style: String, width: Int) -> String {
    let used = str_len(text);
    let pad = width - used;
    if pad < 0 {
        pad = 0;
    }
    let filler = str_repeat(" ", pad);
    return "  " ++ sage_dark() ++ BOX_V ++ reset()
        ++ styled(text, style) ++ filler
        ++ sage_dark() ++ BOX_V ++ reset();
}

pub fn banner(version: String) -> String {
    let w = BANNER_WIDTH;
    let rule = str_repeat(BOX_H, w);

    let quote = "'";
    let owl_beak = '           {`"' ++ quote ++ '`}';

    let top = "  " ++ sage_dark() ++ BOX_TL ++ rule ++ BOX_TR ++ reset();
    let bottom = "  " ++ sage_dark() ++ BOX_BL ++ rule ++ BOX_BR ++ reset();

    let rows = [
        top,
        box_row("", "warm", w),
        box_row("            ___", "gold", w),
        box_row("           (o,o)", "bright", w),
        box_row(owl_beak, "sage", w),
        box_row('           -"-"-', "sage_dark", w),
        box_row("", "warm", w),
        box_row("    W A R D", "bold_gold", w),
        box_row("    The Sage Coding Agent", "sage_light", w),
        box_row("    v" ++ version, "dim", w),
        box_row("", "warm", w),
        bottom
    ];

    return "\n" ++ join(rows, "\n") ++ "\n";
}

// =============================================================================
// The diff — red removals over green additions
// =============================================================================

pub fn render_diff(old_text: String, new_text: String) -> String {
    let out: List<String> = [];
    for line in lines(old_text) {
        out = push(out, "  " ++ red() ++ "- " ++ line ++ reset());
    }
    for line in lines(new_text) {
        out = push(out, "  " ++ green() ++ "+ " ++ line ++ reset());
    }
    return join(out, "\n");
}

// =============================================================================
// Interaction
// =============================================================================

// A Yes/No prompt is split into two PURE helpers — `confirm_prompt` (renders
// the question) and `is_yes` (classifies the answer) — with the `read_line` in
// between done inline in the agent body. This deliberately avoids a single
// `confirm()` helper: `read_line` forces its enclosing free function to be
// `fails`, and Sage 2.2.0 mis-compiles a `fails` function that returns a Bool
// (the `return` isn't `Ok`-wrapped, and the `try ... catch` call site lowers to
// broken Rust). Keeping these two pure dodges that codegen bug entirely.
// See RFC-0024 §11.3.

// The "? <question>  [y/N] " line. Print this, then read a line, then `is_yes`.
pub fn confirm_prompt(question: String) -> String {
    return "  " ++ sage_dark() ++ BOX_V ++ reset() ++ " " ++ gold() ++ "? " ++ reset() ++ warm_white() ++ question ++ reset() ++ sage_light() ++ "  [y/N] " ++ reset();
}

// True only on an explicit yes.
pub fn is_yes(answer: String) -> Bool {
    let a = trim(answer);
    return a == "y" || a == "yes" || a == "Y";
}

pub fn show_commands() -> Unit {
    print("");
    print(styled("  Commands:", "bold_gold"));
    print("");
    print(status("help    ", "Show available commands"));
    print(status("init    ", "Initialize Ward in current project"));
    print(status("scan    ", "Scan project structure"));
    print(status("status  ", "Show Ward session status"));
    print(status("auto    ", "Toggle auto-approve: 'auto on' / 'auto off'"));
    print(status("clear   ", "Clear the screen"));
    print(status("exit    ", "Leave Ward"));
    print("");
    print(ward_says("Type a task in plain English — I'll read, edit, run, and create files to do it."));
    print("");
}
