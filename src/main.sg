// =============================================================================
// Ward — The Sage Coding Agent (Pure Sage)
// =============================================================================
//
// A genuine agentic coding agent: it reads files, edits them surgically, runs
// commands, observes results, and keeps going until a task is done — asking
// permission before it touches anything. See RFC-0024.
//
// This file is the module root: it wires the project together and starts the
// supervision tree. The substance lives in the modules below.
//
//   config.sg    application constants                              (pure)
//   ui.sg        palette, chrome, banner, diff, confirm prompt      (pure)
//   proto.sg     tag decoding + the system/protocol prompt          (pure)
//                (named `proto`, not `protocol`: the latter is a reserved word)
//   tools.sg     observation formatting (line numbers, truncation)  (pure)
//   core.sg      the Ward agent + act-observe loop + Fs/Shell tools
//                (named `core`, not `agent`: the latter is a reserved word)
//
// All `mod` declarations live here, in the entry file: Sage resolves a module
// tree from the root, and other files reach shared items via `use`.

mod config;
mod ui;
mod proto;
mod tools;
mod core;

use core::Ward;

supervisor WardSupervisor {
    strategy: OneForOne
    children {
        Ward { restart: Transient, session_count: 0, project_name: "", history: [], auto: false }
    }
}

run WardSupervisor;
