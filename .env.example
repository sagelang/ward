# Copy to .env (gitignored) and fill in your key.
#   cp .env.example .env  &&  $EDITOR .env
#
# Anthropic via its OpenAI-compatibility endpoint:
SAGE_API_KEY=sk-ant-your-key-here
SAGE_LLM_URL=https://api.anthropic.com/v1
SAGE_MODEL=claude-sonnet-4-5

# --- Or OpenAI (defaults if unset) ---
# SAGE_API_KEY=sk-...
# SAGE_LLM_URL=https://api.openai.com/v1
# SAGE_MODEL=gpt-4o-mini

# --- Or local Ollama (no key needed) ---
# SAGE_API_KEY=local
# SAGE_LLM_URL=http://localhost:11434/v1
# SAGE_MODEL=llama3.1
